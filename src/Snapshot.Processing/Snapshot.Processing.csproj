<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../eng/Versions.props" />
  <PropertyGroup>
    <AssemblyName>Snapshot.Processing</AssemblyName>
    <RootNamespace>Snapshot.Processing</RootNamespace>
    <PackageId>Snapshot.Processing</PackageId>
    <PackageVersion>$(SnapshotPackageVersion)</PackageVersion>
    <Description>Safe validation and conservative minification for Snapshot Protocol HTML artifacts.</Description>
    <PackageTags>snapshot;html;seo;canonical;minify;json;css;static-site</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Snapshot.Protocol/Snapshot.Protocol.csproj" />
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="NUglify" />
  </ItemGroup>
</Project>
