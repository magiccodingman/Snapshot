<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../eng/Versions.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Snapshot.Cli</AssemblyName>
    <RootNamespace>Snapshot.Cli</RootNamespace>
    <PackageId>Snapshot.Cli</PackageId>
    <PackageVersion>$(SnapshotPackageVersion)</PackageVersion>
    <Description>Cross-platform command-line tool for building, inspecting, extracting, and validating Snapshot Protocol ZIP artifacts.</Description>
    <PackageTags>snapshot;cli;playwright;spa;wasm;seo;zip</PackageTags>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>snapshot</ToolCommandName>
    <ToolPackageRuntimeIdentifiers>win-x64;linux-x64;linux-arm64;osx-x64;osx-arm64</ToolPackageRuntimeIdentifiers>
    <PublishAot>true</PublishAot>
    <PlaywrightPlatform Condition="'$(RuntimeIdentifier)' == ''">none</PlaywrightPlatform>
    <PlaywrightPlatform Condition="'$(RuntimeIdentifier)' == 'win-x64'">win-x64</PlaywrightPlatform>
    <PlaywrightPlatform Condition="'$(RuntimeIdentifier)' == 'linux-x64'">linux-x64</PlaywrightPlatform>
    <PlaywrightPlatform Condition="'$(RuntimeIdentifier)' == 'linux-arm64'">linux-arm64</PlaywrightPlatform>
    <PlaywrightPlatform Condition="'$(RuntimeIdentifier)' == 'osx-x64'">osx-x64</PlaywrightPlatform>
    <PlaywrightPlatform Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">osx-arm64</PlaywrightPlatform>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Snapshot.Protocol/Snapshot.Protocol.csproj" />
    <ProjectReference Include="../Snapshot.Playwright/Snapshot.Playwright.csproj" />
  </ItemGroup>
</Project>
